# ===== llm-relay 环境配置 =====
# 复制为 .env 后修改（cp .env.example .env）。.env 已被 git 忽略，不会提交。
# 改动需要重启生效：docker compose restart（或本地重开 node server.js）

# ---- 服务 ----
# 监听端口（宿主机端口 = 容器端口，改这一处即可）
RELAY_PORT=8787

# ---- 国内镜像加速（构建时拉基础镜像 node:22-alpine 用）----
# docker.io 国内拉不到时走镜像站；海外服务器或已配 docker 全局加速的，注释掉这行即可
IMAGE_REGISTRY=docker.m.daocloud.io/library
# 备选（失效就换一个，换完执行 docker compose build --no-cache）：
#   docker.1panel.live/library
#   docker.1ms.run

# ---- 管理页登录密码（强烈建议设置）----
# 设置后打开管理页需先登录；留空 = 管理页无登录保护（仅建议本机调试）
ADMIN_PASSWORD=change-me-a-strong-password

# ---- API 调用密钥（客户端调用 /v1/* 必须携带）----
# 多个 key 用英文逗号分隔，可给不同客户端分发不同 key，停用某客户端只删对应的 key
# 客户端用法：请求头 Authorization: Bearer <key> 或 x-api-key: <key>
API_KEYS=sk-relay-please-change-me-1,sk-relay-please-change-me-2

# ---- 高级（一般不用动）----
# 容器内监听地址：Docker 里必须 0.0.0.0，compose 已固定，无需在此设置
# RELAY_HOST=0.0.0.0
# 出站代理（所有上游请求走它，支持 http/socks5）：留空直连；个别平台要直连可在管理页填 direct
# RELAY_PROXY=
